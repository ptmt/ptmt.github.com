<tr data-post-lang="{{metadata.lang}}">
    <td class="post-file-name">
        <a href="/{{path}}" id="post-{{id}}" lang="{{metadata.lang}}">{{title}}</a>
    </td>
    <td class="post-file-size">{{formatBytes outputSizeBytes}}</td>
    <td class="post-file-date"><time datetime="{{date}}">{{formatDate date "yyyy-MM-dd"}}</time></td>
</tr>

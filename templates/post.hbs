<article>
    <h1>{{post.title}}</h1>
    {{#if post.metadata.description}}
    <p class="post-deck">{{post.metadata.description}}</p>
    {{/if}}
    <div class="content">
        {{{post.content}}}
    </div>
    <footer class="post-meta">
        Published <time datetime="{{post.date}}">{{formatDate post.date "MMMM d, yyyy"}}</time>
    </footer>
</article>

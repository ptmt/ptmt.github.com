<article class="story-reader" aria-label="{{post.title}}" aria-roledescription="story carousel">
    <header class="story-header">
        <div class="story-topline">
            <a href="/" class="story-home">← {{siteName}}</a>
            <time datetime="{{post.date}}">{{formatDate post.date "MMMM d, yyyy"}}</time>
        </div>
        <h1>{{post.title}}</h1>
        {{#if post.metadata.description}}
        <p class="post-subtitle">{{post.metadata.description}}</p>
        {{/if}}
    </header>

    {{#if post.content}}
    <div class="content">{{{post.content}}}</div>
    {{/if}}

    <div class="story-layout">
        <nav class="story-chapters" aria-label="Story chapters">
            {{#each post.metadata.timeline}}
            <a href="#{{id}}" data-story-index="{{@index}}">{{id}}</a>
            {{/each}}
        </nav>

        <div class="story-stage">
            <div class="story-tools" hidden>
                <p class="story-count" role="status" aria-live="polite" aria-atomic="true"></p>
                <span class="story-keyboard-hint" aria-hidden="true">← → to explore</span>
            </div>

            <div class="story-slides">
                {{#each post.metadata.timeline}}
                <section id="{{id}}" class="story-slide" aria-label="{{id}}" aria-roledescription="slide" tabindex="-1">
                    <h2>{{id}}</h2>
                    <figure class="story-figure">
                        <div class="story-media">
                            {{#if img}}
                            <img src="{{img}}" alt="{{alt}}" {{#unless @first}}loading="lazy"{{/unless}} decoding="async">
                            {{else}}
                            <span class="story-image-placeholder">Photo to come</span>
                            {{/if}}
                            <button type="button" class="story-image-next" aria-label="{{#if @last}}Read the story again{{else}}Next moment{{/if}}" hidden></button>
                        </div>
                        <figcaption class="story-caption">
                            {{{md captionText}}}
                        </figcaption>
                    </figure>
                </section>
                {{/each}}
            </div>

            <div class="story-controls" hidden>
                <button type="button" class="story-previous">← Previous</button>
                <button type="button" class="story-next">Next →</button>
            </div>
        </div>
    </div>
</article>

<script>
(function() {
    'use strict';

    const reader = document.querySelector('.story-reader');
    const slides = Array.from(reader.querySelectorAll('.story-slide'));
    if (!slides.length) return;

    const chapters = reader.querySelector('.story-chapters');
    const links = Array.from(chapters.querySelectorAll('[data-story-index]'));
    const previous = reader.querySelector('.story-previous');
    const next = reader.querySelector('.story-next');
    const count = reader.querySelector('.story-count');
    let current = 0;

    function indexFromHash() {
        try {
            const id = decodeURIComponent(location.hash.slice(1));
            const index = slides.findIndex(slide => slide.id === id);
            return index < 0 ? 0 : index;
        } catch (_) {
            return 0;
        }
    }

    function keepChapterVisible() {
        const link = links[current];
        // Scroll only the chapter list, keeping the image and page in place.
        if (chapters.scrollWidth > chapters.clientWidth) {
            chapters.scrollLeft = link.offsetLeft - chapters.clientWidth / 2 + link.offsetWidth / 2;
        } else if (link.offsetTop < chapters.scrollTop) {
            chapters.scrollTop = link.offsetTop;
        } else if (link.offsetTop + link.offsetHeight > chapters.scrollTop + chapters.clientHeight) {
            chapters.scrollTop = link.offsetTop + link.offsetHeight - chapters.clientHeight;
        }
    }

    function show(index, updateHistory = true) {
        if (index < 0 || index >= slides.length) return;
        const focusWillBeHidden = (index !== current && slides[current].contains(document.activeElement))
            || (index === 0 && document.activeElement === previous);

        slides.forEach((slide, i) => {
            slide.hidden = i !== index;
        });
        current = index;
        links.forEach((link, position) => {
            if (position === current) link.setAttribute('aria-current', 'step');
            else link.removeAttribute('aria-current');
        });
        previous.disabled = current === 0;
        next.textContent = current === slides.length - 1 ? 'Read again ↺' : 'Next →';
        count.textContent = String(current + 1).padStart(2, '0') + ' / ' + slides.length;
        count.setAttribute('aria-label', 'Moment ' + (current + 1) + ' of ' + slides.length + ': ' + slides[current].id);
        keepChapterVisible();

        if (updateHistory) {
            history.pushState(null, '', '#' + encodeURIComponent(slides[current].id));
        }
        if (focusWillBeHidden) slides[current].focus({ preventScroll: true });
        if (updateHistory && reader.getBoundingClientRect().top < -20) {
            reader.scrollIntoView({ block: 'start' });
        }
    }

    function advance() {
        show(current === slides.length - 1 ? 0 : current + 1);
    }

    previous.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', advance);
    reader.querySelectorAll('.story-image-next').forEach(button => {
        button.hidden = false;
        button.addEventListener('click', advance);
    });
    links.forEach(link => {
        link.addEventListener('click', event => {
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            event.preventDefault();
            show(Number(link.dataset.storyIndex));
        });
    });

    document.addEventListener('keydown', event => {
        if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
        if (event.target.closest('input, textarea, select, [contenteditable="true"]')) return;
        if (event.key === 'ArrowRight') {
            event.preventDefault();
            if (current < slides.length - 1) show(current + 1);
        } else if (event.key === 'ArrowLeft') {
            event.preventDefault();
            show(current - 1);
        }
    });

    window.addEventListener('popstate', () => show(indexFromHash(), false));
    window.addEventListener('hashchange', () => show(indexFromHash(), false));
    window.addEventListener('resize', keepChapterVisible);

    reader.querySelectorAll('.story-tools, .story-controls').forEach(control => {
        control.hidden = false;
    });
    reader.classList.add('is-interactive');
    show(indexFromHash(), false);
})();
</script>
